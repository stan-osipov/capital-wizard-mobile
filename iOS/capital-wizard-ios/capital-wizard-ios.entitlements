<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Xcode rewrites this to `production` when archiving; `development`
	     is what a debug build needs, and it is what PushService reports as
	     the `sandbox` environment so sends reach the right APNs host. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.capital-wizard.com</string>
		<!-- The marketing apex, claimed for REFERRAL LINKS ONLY. Its
		     association file is an allow-list of /r/* (the opposite shape to
		     app.capital-wizard.com, which the app owns outright) so the
		     homepage, pricing and blog keep opening in the browser. Source of
		     truth: ../capital-wizard-promo/public/.well-known/apple-app-site-association -->
		<string>applinks:capital-wizard.com</string>
	</array>
</dict>
</plist>
