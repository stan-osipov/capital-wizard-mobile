<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- Top app bar: brand lockup (start) + locale pill (end) -->
    <include
        android:id="@+id/app_bar"
        layout="@layout/include_auth_appbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_bar">

        <!-- center_horizontal, never plain center: ScrollView lays its child
             out as a FrameLayout, so a vertical gravity on content TALLER
             than the viewport resolves to a negative top - those pixels sit
             above the scroll origin and nothing can scroll back to them.
             Sign-up lost its title and subtitle that way once the referral
             field pushed the form past the fold. fillViewport already
             handles the shorter-than-viewport case, so the vertical
             centring was never doing any work here. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- ===== Sign-up form ===== -->
            <LinearLayout
                android:id="@+id/signup_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:maxWidth="400dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Auth.Title"
                    android:text="@string/signup_title" />

                <TextView
                    style="@style/Auth.Subtitle"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="20dp"
                    android:text="@string/signup_subtitle" />

                <!-- Email -->
                <TextView
                    style="@style/Auth.FieldLabel"
                    android:text="@string/field_email" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_email"
                    style="@style/Auth.InputLayout"
                    android:layout_marginBottom="14dp"
                    android:hint="@string/hint_email_example">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_email"
                        style="@style/Auth.InputEditText"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password -->
                <TextView
                    style="@style/Auth.FieldLabel"
                    android:text="@string/field_password" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_password"
                    style="@style/Auth.InputLayout"
                    android:hint="@string/hint_password_example"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_password"
                        style="@style/Auth.InputEditText"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Auth.HelperText"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:text="@string/signup_password_hint" />

                <!-- Confirm password -->
                <TextView
                    style="@style/Auth.FieldLabel"
                    android:text="@string/field_confirm_password" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_confirm_password"
                    style="@style/Auth.InputLayout"
                    android:layout_marginBottom="14dp"
                    android:hint="@string/hint_password_example"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_confirm_password"
                        style="@style/Auth.InputEditText"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Referral code. Optional, and the reason this screen leads on
                     a fresh install: the code may have come in through a link,
                     through the Play install referrer, or on the clipboard, and
                     this is the only place a person expects to see it. -->
                <TextView
                    style="@style/Auth.FieldLabel"
                    android:text="@string/signup_referral_label" />

                <!-- Paste lives INSIDE the field, on the same geometry the
                     password toggles above use — the mirror of iOS's trailing
                     accessory. A control floating over the label read as a
                     second thing to do; this one clearly acts on the box it
                     sits in.

                     It is the SUFFIX slot and not an end icon, because the
                     control is a word: `endIconDrawable` can only be a drawable,
                     and a glyph is the one form that cannot be in the app's own
                     language. `SignUpActivity` hangs the click on
                     `getSuffixTextView()` and shows/hides it by setting the
                     suffix text, which is the API that owns that visibility.

                     `hintEnabled="false"` is load-bearing twice over. Material
                     hides prefix/suffix while the hint is EXPANDED — that is,
                     precisely while the box is empty, which is the only time
                     Paste should be on screen — and switching the hint off
                     leaves the suffix permanently visible for us to drive. It
                     also makes this field behave like its iOS twin: "ABCD-1234"
                     is a format example, not a label, and a format example that
                     floats up to sit on the border reads as one. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_referral"
                    style="@style/Auth.InputLayout"
                    app:hintEnabled="false"
                    app:expandedHintEnabled="false"
                    app:suffixText="@string/signup_referral_paste"
                    app:suffixTextColor="@color/accent"
                    app:suffixTextAppearance="@style/Auth.SuffixAction">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_referral"
                        style="@style/Auth.InputEditText"
                        android:hint="@string/hint_referral_example"
                        android:textColorHint="@color/text_subtle"
                        android:imeOptions="actionDone"
                        android:inputType="textCapCharacters|textNoSuggestions" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Auth.HelperText"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/signup_referral_hint" />

                <!-- Terms agreement (gates the primary button) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkbox_terms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:buttonTint="@color/checkbox_tint" />

                    <TextView
                        android:id="@+id/terms_agree_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Primary Create Account (disabled until terms checked) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_create_account"
                    style="@style/Auth.PrimaryButton"
                    android:enabled="false"
                    android:text="@string/signup_button" />

                <!-- Divider: OR SIGN UP WITH -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/border" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="@string/signup_divider"
                        android:textColor="@color/text_subtle"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/border" />

                </LinearLayout>

                <!-- Google (secondary) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_google_sign_up"
                    style="@style/Auth.SecondaryButton"
                    android:text="@string/signup_google"
                    app:icon="@drawable/ic_google" />

                <!-- Already have an account? Sign in -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/signup_have_account"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_back_to_login"
                        style="@style/Auth.LinkButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/signup_login_here" />

                </LinearLayout>

                <!-- Legal footer -->
                <TextView
                    android:id="@+id/legal_footer"
                    style="@style/Auth.LegalFooter"
                    android:layout_marginTop="24dp"
                    android:paddingHorizontal="12dp" />

            </LinearLayout>

            <!-- ===== Confirmation state (hidden initially) ===== -->
            <LinearLayout
                android:id="@+id/confirmation_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:maxWidth="400dp"
                android:orientation="vertical"
                android:paddingVertical="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/signup_confirm_title"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/signup_confirm_description"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_confirm_back_to_login"
                    style="@style/Auth.LinkButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/signup_back_to_login" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/accent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
